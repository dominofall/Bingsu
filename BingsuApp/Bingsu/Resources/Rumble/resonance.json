{
  "format": 1,
  "game": "포켓몬 레조넌스",
  "source": "assets/Battle/audio/sfx/*.wav (PokeRogue 파일), assets/Audio/SE/*.ogg (어나더레드 파일). 볼 소리는 기본 표",
  "detect": {"localNames": ["resonance"]},
  "extends": ["base-essentials", "base-pokerogue"],
  "rules": [
    {"sound": "hit_strong", "match": "exact", "event": "hit_super"},
    {"sound": "hit_weak",   "match": "exact", "event": "hit_weak"},
    {"sound": "hit",        "match": "exact", "event": "hit_normal"},
    {"sound": "faint",      "match": "exact", "event": "faint"}
  ]
}
